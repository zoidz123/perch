+        raise SystemExit(
+            "unable to resolve documentation image from the reviewed Git tree: "
+            f"{display_escape(path, 500)}"
+        )
+    metadata, entry_path = entries[0].split("\t", 1)
+    fields = metadata.split()
+    if len(fields) != 3 or entry_path != path or fields[1] != "blob":
+        raise SystemExit(
+            "unable to validate documentation image metadata from the reviewed Git tree: "
+            f"{display_escape(path, 500)}"
+        )
+    return fields[0], read_git_blob(repo, fields[2])
