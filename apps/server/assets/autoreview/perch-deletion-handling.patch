+def read_git_blob(repo: Path, object_id: str) -> bytes:
+    if re.fullmatch(r"[0-9a-f]{40,64}", object_id) is None:
+        raise SystemExit("refusing documentation image with an invalid Git object id")
+    blob_size_text = git(repo, "cat-file", "-s", object_id).strip()
+    if re.fullmatch(r"\d+", blob_size_text) is None:
+        raise SystemExit("unable to determine documentation image size from the reviewed Git object")
+    blob_size = int(blob_size_text)
+    if blob_size > MAX_DOCUMENTATION_PNG_BYTES:
+        raise SystemExit(
+            "refusing documentation image addition because it exceeds "
+            f"{MAX_DOCUMENTATION_PNG_BYTES} byte limit: {blob_size} bytes"
+        )
+    result = subprocess.run(
+        [
+            resolve_command("git", repo),
+            "--no-optional-locks",
+            *SAFE_GIT_CONFIG_ARGS,
+            "cat-file",
+            "blob",
+            object_id,
+        ],
+        cwd=repo,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        env=safe_git_env(repo),
+    )
+    if result.returncode != 0:
+        raise SystemExit(
+            "unable to read documentation image from the reviewed Git object: "
+            f"{display_escape(result.stderr.decode('utf-8', 'replace'), 500)}"
+        )
+    if len(result.stdout) != blob_size:
+        raise SystemExit("unable to read the expected documentation image bytes from the reviewed Git object")
+    return result.stdout
