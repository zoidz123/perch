+def bounded_zlib_payload(data: bytes, limit: int) -> bytes | None:
+    try:
+        inflater = zlib.decompressobj()
+        payload = inflater.decompress(data, limit + 1)
+        if len(payload) > limit or inflater.unconsumed_tail:
+            return None
+        payload += inflater.flush(limit - len(payload) + 1)
+    except zlib.error:
+        return None
+    if len(payload) > limit or not inflater.eof or inflater.unused_data:
+        return None
+    return payload
+
+
+def documentation_png_error(data: bytes) -> str | None:
+    if len(data) > MAX_DOCUMENTATION_PNG_BYTES:
+        return f"exceeds {MAX_DOCUMENTATION_PNG_BYTES} byte limit"
+    if not data.startswith(b"\x89PNG\r\n\x1a\n"):
+        return "does not have a PNG signature"
+
+    offset = 8
+    width = height = bit_depth = color_type = -1
+    saw_ihdr = saw_idat = saw_iend = saw_plte = False
+    idat_finished = False
+    metadata_bytes = 0
+    image_data = bytearray()
+    while offset < len(data):
+        if len(data) - offset < 12:
+            return "has a truncated PNG chunk"
+        length = int.from_bytes(data[offset:offset + 4], "big")
+        chunk_type = data[offset + 4:offset + 8]
+        chunk_start = offset + 8
+        chunk_end = chunk_start + length
+        checksum_end = chunk_end + 4
+        if chunk_end > len(data) - 4:
+            return "has a truncated PNG chunk"
+        if re.fullmatch(rb"[A-Za-z]{4}", chunk_type) is None:
+            return "has an invalid PNG chunk type"
+        if chunk_type[2] & 0x20:
+            return "uses a PNG chunk with an invalid reserved bit"
+        chunk_data = data[chunk_start:chunk_end]
+        expected_checksum = int.from_bytes(data[chunk_end:checksum_end], "big")
+        if binascii.crc32(chunk_type + chunk_data) & 0xFFFFFFFF != expected_checksum:
+            return "has an invalid PNG chunk checksum"
+
+        if chunk_type == b"IHDR":
+            if saw_ihdr or offset != 8 or length != 13:
+                return "has an invalid PNG header"
+            saw_ihdr = True
+            width = int.from_bytes(chunk_data[0:4], "big")
+            height = int.from_bytes(chunk_data[4:8], "big")
+            bit_depth = chunk_data[8]
+            color_type = chunk_data[9]
+            compression_method = chunk_data[10]
+            filter_method = chunk_data[11]
+            interlace_method = chunk_data[12]
+            valid_bit_depths = {
+                0: {1, 2, 4, 8},
+                2: {8},
+                3: {1, 2, 4, 8},
+                4: {8},
+                6: {8},
+            }
+            if (
+                width < 1
+                or height < 1
+                or width > MAX_DOCUMENTATION_PNG_DIMENSION
+                or height > MAX_DOCUMENTATION_PNG_DIMENSION
+                or width * height > MAX_DOCUMENTATION_PNG_PIXELS
+                or bit_depth not in valid_bit_depths.get(color_type, set())
+                or compression_method != 0
+                or filter_method != 0
+                or interlace_method != 0
+            ):
+                return "exceeds PNG dimension or pixel limits"
+        elif chunk_type == b"PLTE":
+            if not saw_ihdr or saw_idat or saw_plte or length == 0 or length % 3:
+                return "has an invalid PNG palette"
+            if color_type in {0, 4} or length > 768:
+                return "has an invalid PNG palette"
+            saw_plte = True
+        elif chunk_type == b"IDAT":
+            if not saw_ihdr or saw_iend or idat_finished:
+                return "has non-contiguous PNG image data"
+            if length == 0:
+                return "has empty PNG image data"
+            saw_idat = True
+            image_data.extend(chunk_data)
+        elif chunk_type == b"IEND":
+            if not saw_ihdr or not saw_idat or length != 0 or checksum_end != len(data):
+                return "has an invalid PNG end marker or trailing data"
+            saw_iend = True
+            break
+        else:
+            if not saw_ihdr or saw_iend:
+                return "has an invalid PNG chunk order"
+            if not chunk_type[0] & 0x20:
+                return "uses an unknown critical PNG chunk"
+            if chunk_type not in DOCUMENTATION_PNG_ANCILLARY_CHUNKS:
+                return "uses an unapproved PNG metadata chunk"
+            metadata_bytes += length
+            if metadata_bytes > MAX_DOCUMENTATION_PNG_METADATA_BYTES:
+                return "exceeds PNG metadata limit"
+            if chunk_type == b"cICP" and length != 4:
+                return "has invalid PNG color metadata"
+            if chunk_type == b"pHYs" and length != 9:
+                return "has invalid PNG physical-size metadata"
+            if chunk_type == b"iCCP":
+                profile_name, separator, compressed_profile = chunk_data.partition(b"\0")
+                if (
+                    not separator
+                    or not 1 <= len(profile_name) <= 79
+                    or not compressed_profile
+                    or compressed_profile[0] != 0
+                    or bounded_zlib_payload(
+                        compressed_profile[1:],
+                        MAX_DOCUMENTATION_PNG_DECOMPRESSED_METADATA_BYTES,
+                    ) is None
+                ):
+                    return "has invalid or oversized PNG color metadata"
+            if chunk_type == b"iTXt":
+                keyword, separator, text_metadata = chunk_data.partition(b"\0")
+                if (
+                    not separator
+                    or not 1 <= len(keyword) <= 79
+                    or len(text_metadata) < 2
+                    or text_metadata[0] != 0
+                    or text_metadata[1] != 0
+                ):
+                    return "has unsupported compressed PNG text metadata"
+            if saw_idat:
+                idat_finished = True
+        offset = checksum_end
+
+    if not saw_ihdr or not saw_idat or not saw_iend:
+        return "is not a complete PNG image"
+    if color_type == 3 and not saw_plte:
+        return "is missing its indexed PNG palette"
+
+    channels = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}[color_type]
+    expected_raw_bytes = height * (1 + (width * channels * bit_depth + 7) // 8)
+    raw = bounded_zlib_payload(bytes(image_data), expected_raw_bytes)
+    if raw is None:
+        return "has invalid compressed PNG image data"
+    if len(raw) != expected_raw_bytes:
+        return "expands beyond its declared PNG dimensions"
+    return None
+
+
+def review_documentation_image_additions(
+    repo: Path,
+    added_paths: set[str],
+    read_image: Callable[[str], tuple[str, bytes]],
+) -> set[str]:
+    approved: set[str] = set()
+    for path in added_paths:
+        if not documentation_image_path(path):
+            continue
+        mode, data = read_image(path)
+        if mode != "100644":
+            raise SystemExit(
+                "refusing documentation image addition because it is not a "
+                f"non-executable regular file: {display_escape(path, 500)}"
+            )
+        error = documentation_png_error(data)
+        if error is not None:
+            raise SystemExit(
+                "refusing documentation image addition because it is not a "
+                f"safe PNG: {display_escape(path, 500)} ({error})"
+            )
+        approved.add(path)
+    return approved
+
