+def worktree_documentation_image_blob(repo: Path, path: str) -> tuple[str, bytes]:
+    relative = PurePosixPath(path)
+    if relative.is_absolute() or ".." in relative.parts or not relative.parts:
+        raise SystemExit(
+            f"refusing documentation image with an unsafe path: {display_escape(path, 500)}"
+        )
+    relative_path = Path(*relative.parts)
+    if raw_repo_path_has_symlink_component(repo, relative_path.parent):
+        raise SystemExit(
+            "refusing documentation image through a symlinked parent directory: "
+            f"{display_escape(path, 500)}"
+        )
+    image_path = repo / relative_path
+    try:
+        before = os.lstat(image_path)
+    except OSError as exc:
+        raise SystemExit(
+            "unable to read documentation image from the working tree: "
+            f"{display_escape(path, 500)}"
+        ) from exc
+    if not stat.S_ISREG(before.st_mode):
+        return "non-regular", b""
+    if before.st_mode & 0o111:
+        return "executable", b""
+    if before.st_size > MAX_DOCUMENTATION_PNG_BYTES:
+        raise SystemExit(
+            "refusing documentation image addition because it exceeds "
+            f"{MAX_DOCUMENTATION_PNG_BYTES} byte limit: {before.st_size} bytes"
+        )
+
+    descriptor: int | None = None
+    try:
+        descriptor = os.open(
+            image_path,
+            os.O_RDONLY
+            | getattr(os, "O_BINARY", 0)
+            | getattr(os, "O_CLOEXEC", 0)
+            | getattr(os, "O_NOFOLLOW", 0),
+        )
+        opened = os.fstat(descriptor)
+        if (
+            not stat.S_ISREG(opened.st_mode)
+            or (before.st_dev, before.st_ino) != (opened.st_dev, opened.st_ino)
+        ):
+            raise OSError("file changed while opening")
+        data = bytearray()
+        while len(data) <= MAX_DOCUMENTATION_PNG_BYTES:
+            chunk = os.read(
+                descriptor,
+                min(64 * 1024, MAX_DOCUMENTATION_PNG_BYTES + 1 - len(data)),
+            )
+            if not chunk:
+                break
+            data.extend(chunk)
+        after = os.fstat(descriptor)
+        if (
+            opened.st_mode,
+            opened.st_size,
+            opened.st_mtime_ns,
+        ) != (
+            after.st_mode,
+            after.st_size,
+            after.st_mtime_ns,
+        ):
+            raise OSError("file changed while reading")
+    except OSError as exc:
+        raise SystemExit(
+            "unable to read documentation image from the working tree: "
+            f"{display_escape(path, 500)}"
+        ) from exc
+    finally:
+        if descriptor is not None:
+            os.close(descriptor)
+    return "100644", bytes(data)
+
