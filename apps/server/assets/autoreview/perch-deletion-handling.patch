+        raise SystemExit(
+            "unable to resolve documentation image from the staged Git index: "
+            f"{display_escape(path, 500)}"
+        )
+    metadata, entry_path = entries[0].split("\t", 1)
+    fields = metadata.split()
+    if (
+        len(fields) != 3
+        or entry_path != path
+        or fields[2] != "0"
+    ):
